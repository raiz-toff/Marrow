{
  "name": "marrow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Agent-driven network topology studio — compile YAML into self-contained, interactive, offline HTML network diagrams.",
  "keywords": [
    "network",
    "topology",
    "diagram",
    "network-diagram",
    "visualization",
    "yaml",
    "interactive",
    "svg",
    "devops",
    "infrastructure"
  ],
  "homepage": "https://github.com/raiz-toff/Marrow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raiz-toff/Marrow.git"
  },
  "bugs": {
    "url": "https://github.com/raiz-toff/Marrow/issues"
  },
  "license": "MIT",
  "author": "rajkumar",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node packages/cli/dist/index.js serve",
    "dev:lan": "node packages/cli/dist/index.js serve --host 0.0.0.0",
    "start": "npm run dev",
    "build": "node packages/cli/dist/index.js build",
    "validate": "node packages/cli/dist/index.js validate",
    "snapshot": "node packages/cli/dist/index.js snapshot",
    "icons": "node packages/cli/dist/index.js icons",
    "marrow": "node packages/cli/dist/index.js",
    "compile": "tsc -b && npm run bundle -w @marrow/runtime && npm run registry:build",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:icons": "node packages/cli/dist/index.js icons index",
    "icons:index": "node packages/cli/dist/index.js icons index",
    "registry:build": "node scripts/build-registry.mjs",
    "docs": "npm run dev -w @marrow/docs",
    "docs:build": "npm run registry:build && npm run build -w @marrow/docs",
    "demos": "node docs/scripts/build-demos.mjs",
    "build:npm": "npm run compile && node scripts/build-npm.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.59.0",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
