<?xml version="1.0" encoding="UTF-8"?>
<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Rackmount Server Chassis -->
  <rect x="4" y="16" width="56" height="32" rx="2" fill="#1e293b" stroke="#94a3b8" stroke-width="2"/>
  
  <!-- Rack Ears -->
  <rect x="2" y="18" width="2" height="28" fill="#cbd5e1"/>
  <rect x="60" y="18" width="2" height="28" fill="#cbd5e1"/>
  
  <!-- Drive Bays / Vents -->
  <rect x="10" y="24" width="8" height="16" rx="1" fill="#334155"/>
  <rect x="22" y="24" width="8" height="16" rx="1" fill="#334155"/>
  <rect x="34" y="24" width="8" height="16" rx="1" fill="#334155"/>
  
  <!-- Status Lights -->
  <circle cx="50" cy="28" r="1.5" fill="#22c55e"/> <!-- Green Power -->
  <circle cx="54" cy="28" r="1.5" fill="#eab308"/> <!-- Amber Activity -->
  
  <!-- Power Button -->
  <circle cx="52" cy="38" r="2" fill="#ef4444"/>
</svg>
