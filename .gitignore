# dependencies & build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# generated diagram output (never committed)
output/

# npm publish staging for the marrow-cli bundle — regenerated by `npm run build:npm`
dist-npm/
*.tgz

# docs site build artifacts (Next.js & Fumadocs)
docs/.next/
docs/.source/

# vendor icon packs fetched per-user — never committed (vendor terms allow
# diagram use, not redistribution). Fetched whole, manifest generated on fetch:
# `marrow icons fetch`. See icon-packs/LICENSES.md.
#
# cisco is NOT here: it is committed. Its SVGs are jgraph's Apache-2.0 drawio
# stencils, not Cisco's artwork, so they are ours to redistribute — subject to
# the Atlassian clause documented in icon-packs/LICENSES.md.
icon-packs/aws/
icon-packs/azure/
icon-packs/gcp/

# archived v1 (kept locally for reference, not tracked)
legacy-v1/

# os / editor
.DS_Store
*.log
.vscode/
.idea/
*.swp
.vercel
