# The Vercel CLI does NOT read .gitignore — without this file it uploads the
# whole working tree (20k+ files: build output, Python venvs, fetched icon
# packs) and hits the 15,000-file limit. The docs site is the only deploy
# target and needs none of the below. Keep packages/ (npm workspace members the
# root install resolves) and docs/ (the site itself).

# Generated Marrow build output
output/

# Archived Python v1 (reference only) + its virtualenvs
legacy-v1/

# Vendor icon packs fetched per user (never committed). The demos, compiled
# during the deploy, use only the bundled packs (cisco, affinity, k8s, generic).
icon-packs/aws/
icon-packs/azure/
icon-packs/gcp/

# Corpus fixtures and sample inputs — not needed to build the docs
fixtures/
input/

# Local Vercel link state (also gitignored)
.vercel/

# Packaged CLI artifacts and agent configurations
dist-npm/
.agents/
.claude/
